{
  "expo": {
    "name": "We1ssConnect",
    "slug": "we1ssconnect",
    "version": "1.2.0",
    "scheme": "we1ssconnect",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0a0a0a",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "android": {
      "package": "com.we1bschatten.we1ssconnect",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "extraProguardRules": "-keep class libXray.** { *; }\n-keep class go.** { *; }\n-keep class xraybridge.** { *; }\n-keep class com.we1bschatten.xrayvpn.** { *; }",
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withLibXray",
      "./plugins/withAbiSplits",
      [
        "expo-camera",
        {
          "cameraPermission": "We1ssConnect uses the camera to scan QR codes with server links.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    }
  }
}
