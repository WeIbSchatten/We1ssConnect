msgid "To keep the tunnel working, these were stopped and their autostart turned off: %s. Nothing was removed; turn them back on under System → Startup after disconnecting here."
msgstr "Чтобы туннель работал, остановлены и выключены из автозапуска: %s. Ничего не удалено; вернуть их можно в «Система → Загрузка», отключив здесь We1ssConnect."

msgid "Tunnel"
msgstr "Туннель"

msgid "Everything goes through the tunnel except direct rules and bypassed devices."
msgstr "Через туннель идёт всё, кроме прямых правил и исключённых устройств."

msgid "Only sites and services from routing rules go through the tunnel."
msgstr "Через туннель идут только сайты и сервисы из правил маршрутизации."

msgid "Server"
msgstr "Сервер"

msgid "Exit IP"
msgstr "Внешний IP"

msgid "Speed test"
msgstr "Проверка скорости"

msgid "Connect to see the exit IP."
msgstr "Подключитесь, чтобы увидеть внешний IP."

msgid "Checking…"
msgstr "Проверка…"

msgid "No answer through the tunnel."
msgstr "Нет ответа через туннель."

