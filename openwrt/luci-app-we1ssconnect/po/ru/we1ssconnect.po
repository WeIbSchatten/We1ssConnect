msgstr "транспорт %s не поддерживается sing-box"

msgid "Shadowsocks plugin %s is not supported by sing-box"
msgstr "плагин Shadowsocks %s не поддерживается sing-box"

msgid "Missing: %s"
msgstr "не хватает: %s"

