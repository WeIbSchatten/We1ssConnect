
config settings 'main'
	option enabled '0'
	option mode 'selective'
	option selected 'auto'
	option dns_type 'doh'
	option dns_server '1.1.1.1'
	option bootstrap_dns '77.88.8.8'
	option direct_dns '77.88.8.8'
	list source_iface 'br-lan'
	option exclude_ntp '1'
	option intercept_dns '1'
	option force_chrome_fp '1'
	option list_update_interval '1d'
	option sub_update_interval '12h'
	option manage_dnsmasq '1'
	option log_level 'warn'

config rule 'r_youtube'
	option name 'YouTube'
	option enabled '0'
	option action 'proxy'
	option target 'auto'
	list service 'youtube'

config rule 'r_ru'
	option name 'Russian sites directly'
	option enabled '0'
	option action 'direct'
	list preset 'ru'

config rule 'r_ads'
	option name 'Block ads'
	option enabled '0'
	option action 'block'
	list preset 'ads'
