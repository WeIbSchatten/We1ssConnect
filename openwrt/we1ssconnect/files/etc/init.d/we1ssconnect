#!/bin/sh /etc/rc.common
# We1ssConnect: builds the sing-box config, runs sing-box (and Xray for REALITY servers) and the
# nft/dnsmasq interception.

START=99
STOP=10
USE_PROCD=1

RUN_DIR=/var/run/we1ssconnect

start_service() {
	config_load we1ssconnect
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0

	/usr/bin/we1ssconnect prepare > /dev/null || return 1

	procd_open_instance sing-box
	procd_set_param command /usr/bin/sing-box run -c "$RUN_DIR/config.json" -D "$RUN_DIR"
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="65535 65535"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	local xray
	xray="$(jsonfilter -i "$RUN_DIR/status.json" -e '@.xray' 2> /dev/null)"
	if [ -n "$xray" ]; then
		procd_open_instance xray
		procd_set_param command "$xray" run -c "$RUN_DIR/xray.json"
		procd_set_param respawn 3600 5 5
		procd_set_param limits nofile="65535 65535"
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	/usr/bin/we1ssconnect apply-net > /dev/null
}

stop_service() {
	/usr/bin/we1ssconnect cleanup > /dev/null
}

service_triggers() {
	procd_add_reload_trigger we1ssconnect
}

reload_service() {
	stop
	start
}
